set -euo pipefail
# Print the Execution Plane alembic revision, or NONE.
# Checks schema execution_plane then public. Never prints passwords.
DB='{{ pg_execution_plane_database }}'
if ! psql -U postgres -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname='${DB}'" | grep -qx 1; then
  echo NONE
  exit 0
fi
REV="$(psql -U postgres -d "${DB}" -tAc "SELECT version_num FROM execution_plane.alembic_version LIMIT 1" 2>/dev/null || true)"
if [ -z "${REV}" ]; then
  REV="$(psql -U postgres -d "${DB}" -tAc "SELECT version_num FROM public.alembic_version LIMIT 1" 2>/dev/null || true)"
fi
echo "${REV:-NONE}"
