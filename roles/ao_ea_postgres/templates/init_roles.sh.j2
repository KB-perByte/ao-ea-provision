set -euo pipefail
psql -U postgres -d postgres -v ON_ERROR_STOP=1 <<'EOSQL'
DO $$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'orchestrator') THEN
    CREATE ROLE orchestrator LOGIN PASSWORD '{{ pg_orchestrator_password | regex_replace("'", "''") }}';
  ELSE
    ALTER ROLE orchestrator WITH LOGIN PASSWORD '{{ pg_orchestrator_password | regex_replace("'", "''") }}';
  END IF;
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'temporal') THEN
    CREATE ROLE temporal LOGIN PASSWORD '{{ pg_temporal_password | regex_replace("'", "''") }}';
  ELSE
    ALTER ROLE temporal WITH LOGIN PASSWORD '{{ pg_temporal_password | regex_replace("'", "''") }}';
  END IF;
END
$$;
SELECT 'CREATE DATABASE orchestrator OWNER orchestrator'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'orchestrator')\gexec
SELECT 'CREATE DATABASE temporal OWNER temporal'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'temporal')\gexec
SELECT 'CREATE DATABASE temporal_visibility OWNER temporal'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'temporal_visibility')\gexec
EOSQL
